#!/usr/bin/python3
# Backward compatibility wrapper for uninstaller command
import os
import sys

# Locate wheresapp executable in the same directory or system path
script_dir = os.path.dirname(os.path.abspath(__file__))
wheresapp_bin = os.path.join(script_dir, "wheresapp")

if not os.path.isfile(wheresapp_bin):
    wheresapp_bin = "/usr/local/bin/wheresapp"

args = [wheresapp_bin, "--mode=uninstall"] + sys.argv[1:]
os.execv(wheresapp_bin, args)