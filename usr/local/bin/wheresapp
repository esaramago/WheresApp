#!/usr/bin/python3
# Entry point for WheresApp GTK 4 / Libadwaita application
import argparse
import os
import sys

# Clear environment variables inherited from Snap or Flatpak contexts (e.g., VS Code terminal)
# that may cause library conflicts with host GTK 4 or glibc
for var in [
    "GTK_PATH",
    "GTK_EXE_PREFIX",
    "GTK_IM_MODULE_FILE",
    "GIO_MODULE_DIR",
    "GSETTINGS_SCHEMA_DIR",
    "GDK_PIXBUF_MODULE_FILE",
    "GDK_PIXBUF_MODULEDIR",
    "LOCPATH",
]:
    os.environ.pop(var, None)

# Locate share directory for modules and translations
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
POSSIBLE_PATHS = [
    os.path.abspath(os.path.join(SCRIPT_DIR, "../../share/wheresapp")),
    os.path.abspath(os.path.join(SCRIPT_DIR, "../share/wheresapp")),
    "/usr/share/wheresapp",
    "/usr/local/share/wheresapp",
]

SHARE_DIR = None
for candidate in POSSIBLE_PATHS:
    if os.path.isdir(candidate) and os.path.isfile(os.path.join(candidate, "ui.py")):
        SHARE_DIR = candidate
        break

if SHARE_DIR and SHARE_DIR not in sys.path:
    sys.path.insert(0, SHARE_DIR)

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio

from i18n import I18n
from ui import WheresAppWindow


class WheresApp(Adw.Application):
    """Main application instance."""

    def __init__(self, requested_lang: str | None = None, initial_query: str = ""):
        super().__init__(
            application_id="com.github.esaramago.wheresapp",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE | Gio.ApplicationFlags.NON_UNIQUE,
        )
        self.requested_lang = requested_lang
        self.initial_query = initial_query
        self.window: WheresAppWindow | None = None

    def do_activate(self):
        """Handle application activation."""
        if not self.window:
            i18n = I18n(self.requested_lang)
            self.window = WheresAppWindow(self, i18n, self.initial_query)
        self.window.present()

    def do_command_line(self, command_line: Gio.ApplicationCommandLine) -> int:
        """Parse command line options and activate window."""
        args = command_line.get_arguments()
        # Parse arguments passed through GApplication
        parser = argparse.ArgumentParser(description="WheresApp - Application search and uninstaller")
        parser.add_argument("--lang", "-l", help="Language code (pt or en)", default=None)
        parser.add_argument("--mode", help="Execution mode (default or uninstall)", default="default")
        parser.add_argument("query", nargs="*", help="Initial search term")

        try:
            parsed, _ = parser.parse_known_args(args[1:])
            if parsed.lang:
                self.requested_lang = parsed.lang
            if parsed.query:
                self.initial_query = " ".join(parsed.query)
        except Exception:
            pass

        self.activate()
        return 0


def main():
    """Main entry point."""
    # Pre-parse command line arguments
    parser = argparse.ArgumentParser(description="WheresApp - Application search and uninstaller")
    parser.add_argument("--lang", "-l", help="Language code (pt or en)", default=None)
    parser.add_argument("--mode", help="Execution mode (default or uninstall)", default="default")
    parser.add_argument("query", nargs="*", help="Initial search term")

    parsed, unknown = parser.parse_known_args()
    query = " ".join(parsed.query) if parsed.query else ""

    app = WheresApp(requested_lang=parsed.lang, initial_query=query)
    # Pass clean argv to Adw.Application
    sys.exit(app.run([sys.argv[0]] + unknown))


if __name__ == "__main__":
    main()
